<div class="sla-chat-card damage-result">
    {{#if isHeal}}
    <div class="damage-header heal">
        {{victimName}} — {{localize "SLA.HealResultHeader"}}
    </div>
    <div class="damage-row">
        <span>{{localize "SLA.HealRolled"}}:</span> <strong>{{rawDamage}}</strong>
    </div>
    <div class="damage-row final">
        <span>{{localize "SLA.HealApplied"}}:</span> <strong class="final-value heal-value">{{finalDamage}}</strong>
    </div>
    <div class="damage-hp">
        HP: {{hpData.old}} &rarr; <strong>{{hpData.new}}</strong>
    </div>
    <div class="damage-undo-row">
        <button class="undo-damage-btn" data-victim-uuid="{{undo.victimUuid}}"
                {{#if undo.undone}}disabled title="{{localize 'SLA.DamageAlreadyUndone'}}"{{/if}}>
            <i class="fas fa-undo"></i> {{localize "SLA.UndoDamage"}}
        </button>
    </div>
    {{else}}
    <div class="damage-header">
        {{victimName}} Hit!
    </div>

    <div class="damage-row">
        <span>Raw Damage:</span> <strong>{{rawDamage}}</strong>
    </div>
    <div class="damage-row reduction">
        <span>PV Reduction:</span> <strong>-{{effectivePV}}</strong>
    </div>
    <div class="damage-row final">
        <span>Final HP Loss:</span> <strong class="final-value">{{finalDamage}}</strong>
    </div>

    <div class="damage-hp">
        HP: {{hpData.old}} &rarr; <strong>{{hpData.new}}</strong>
    </div>

    {{#if armorData}}
    {{#each armorData}}
    <div class="damage-armor damage-armor--{{this.kind}}">
        <i class="fas {{#if (eq this.kind "shield")}}fa-shield{{else}}fa-shield-alt{{/if}}"></i>
        {{this.name}} Res: {{this.current}} &rarr; {{this.new}} (-{{this.ad}}), PV: {{this.effectivePV}}
    </div>
    {{/each}}
    {{/if}}

    {{#if pvMod}}
    <div class="damage-ammo">
        <i class="fas fa-flask"></i> Armor PV: {{rawPv}} &rarr; {{targetPV}}{{#if ammoName}} ({{ammoName}}){{/if}}
    </div>
    {{/if}}

    <div class="damage-undo-row">
        <button class="undo-damage-btn" data-victim-uuid="{{undo.victimUuid}}"
                {{#if undo.undone}}disabled title="{{localize 'SLA.DamageAlreadyUndone'}}"{{/if}}>
            <i class="fas fa-undo"></i> {{localize "SLA.UndoDamage"}}
        </button>
    </div>
    {{/if}}
</div>
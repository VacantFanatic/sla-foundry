<div class="luck-dialog" role="dialog" aria-label="{{localize 'SLA.LuckDialog.AriaLabel'}}">
    <p class="sla-dialog-hint sla-dialog-hint--block">Select a benefit to apply. You have
        <strong>{{luck.value}}</strong> / {{luck.max}} Luck remaining.</p>

    <!-- SECTION 1: GENERIC OPTIONS -->
    <div class="sla-panel sla-dialog-panel">
        <div class="sla-header-bar-small">Generic Options</div>
        <div class="sla-dialog-panel-body">
            <div class="sla-dialog-field-stack">
                <button type="button" data-action="rerollSd" class="sla-dialog-btn sla-dialog-btn--outline"
                    {{#if (or (lt luck.value 1) rofRerollSD)}}disabled{{/if}}>
                    Reroll Success Die {{#if rofRerollSD}}(ROF Rerolled){{else}}(Cost: 1){{/if}}
                </button>

                <div class="sla-dialog-row-inline">
                    <button type="button" data-action="addMod"
                        class="sla-dialog-btn sla-dialog-btn--outline sla-dialog-btn--grow" {{#if (lt luck.value
                        1)}}disabled{{/if}}>
                        Add Modifier (Cost: Variable)
                    </button>
                    <input type="number" name="modAmount" value="1" min="1" max="{{luck.value}}"
                        class="sla-dialog-input-sm">
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: REROLL SKILL DICE -->
    <div class="sla-panel sla-dialog-panel">
        <div class="sla-header-bar-small">Reroll Skill Dice (Cost: 1 Total)</div>
        <div class="sla-dialog-panel-body">
            <p class="sla-dialog-hint">Select dice to reroll:</p>
            <div class="sla-dialog-dice-list">
                {{#each skillDice}}
                <label class="sla-dialog-die {{#if this.disabled}}is-disabled{{/if}}">
                    <input type="checkbox" name="rerollSelect" value="{{@index}}" {{#if this.disabled}}disabled{{/if}}>
                    <span class="sla-dialog-die-value" style="color: {{this.borderColor}};">{{this.total}}</span>
                </label>
                {{/each}}
            </div>

            <button type="button" data-action="rerollSkill"
                class="sla-dialog-btn sla-dialog-btn--outline sla-dialog-btn--block" {{#if (lt luck.value
                1)}}disabled{{/if}}>
                Reroll Selected Dice
            </button>
        </div>
    </div>
</div>
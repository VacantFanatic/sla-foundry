<div class="sla-simple-dialog-root" role="dialog" aria-label="{{title}}">
    <div class="sla-simple-dialog-inner">{{{html}}}</div>
    <div class="sla-simple-dialog-footer">
        <button type="button" class="sla-dialog-btn sla-dialog-btn--neutral" data-action="closeDialog">Cancel</button>
        <button type="button" class="sla-dialog-btn sla-dialog-btn--primary" data-action="confirmDialog">
            <i class="fas fa-dice-d20"></i> {{actionLabel}}
        </button>
    </div>
</div>

<div class="sla-game-clock-root" role="group" aria-label="{{localize 'SLA.GameClock.Title'}}">
    <div class="sla-game-clock-time" aria-live="polite">{{time}}</div>
    <p class="sla-game-clock-hint">{{roundLabel}}</p>

    <div class="sla-game-clock-group">
        <h4>{{localize 'SLA.GameClock.AdvanceHeading'}}</h4>
        <div class="sla-game-clock-buttons">
            {{#each advance}}
            <button type="button" class="sla-dialog-btn sla-dialog-btn--primary" data-action="shiftTime" data-seconds="{{seconds}}" data-preset="{{id}}">{{label}}</button>
            {{/each}}
        </div>
    </div>

    <div class="sla-game-clock-group">
        <h4>{{localize 'SLA.GameClock.RewindHeading'}}</h4>
        <div class="sla-game-clock-buttons">
            {{#each rewind}}
            <button type="button" class="sla-dialog-btn sla-dialog-btn--neutral" data-action="shiftTime" data-seconds="{{seconds}}" data-preset="{{id}}">{{label}}</button>
            {{/each}}
        </div>
    </div>
</div>

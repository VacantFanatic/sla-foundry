<p class="sla-dialog-hint sla-dialog-hint--block">Select magazine to load into <strong>{{weaponName}}</strong>:</p>
<div class="form-group">
    <select id="magazine-select" class="sla-dialog-select sla-dialog-select--full">
        {{#each candidates}}
        <option value="{{this.id}}">{{this.name}} (Qty: {{this.system.quantity}})</option>
        {{/each}}
    </select>
</div>
<form class="sla-dialog-form">
    {{!-- COMMON HEADER --}}
    <div class="sla-dialog-row sla-dialog-row--modifier">
        <label>Generic Modifier (+/-)</label>
        <input type="number" name="modifier" value="{{modifier}}" placeholder="0" class="sla-dialog-input-sm" />
    </div>

    <hr class="sla-dialog-divider" />

    {{!-- MELEE SECTION --}}
    {{#if isMelee}}
    {{!-- SECTION 1: ATTACKER --}}
    <div class="sla-panel sla-dialog-panel">
        <div class="sla-header-bar-small">Attacker Stance &amp; Options</div>
        <div class="sla-dialog-panel-body">
            <div class="sla-dialog-checks">
                <label class="sla-dialog-check"><input type="checkbox" name="charging" /> Charging</label>
                <label class="sla-dialog-check"><input type="checkbox" name="targetCharged" /> Target
                    Charged/Moved Fast</label>
                <label class="sla-dialog-check"><input type="checkbox" name="sameTarget" /> Same Target</label>
                <label class="sla-dialog-check"><input type="checkbox" name="breakOff" /> Break Off</label>
                <label class="sla-dialog-check"><input type="checkbox" name="natural" /> Natural Wpn</label>
                <label class="sla-dialog-check"><input type="checkbox" name="prone" /> Target
                    Prone/Stunned/Immobile (+2)</label>
            </div>

            <div class="sla-dialog-row sla-dialog-row--divided">
                <label class="sla-dialog-row-label--accent">Reserve Combat Dice</label>
                <div class="sla-dialog-row-inline">
                    <span class="sla-dialog-hint">Subtracted from your Skill Dice pool.</span>
                    <input type="number" name="reservedDice" value="0" min="0" placeholder="0"
                        class="sla-dialog-input-sm" />
                </div>
            </div>
        </div>
    </div>

    {{!-- SECTION 2: TARGET --}}
    <div class="sla-panel sla-dialog-panel">
        <div class="sla-header-bar-small">Target Defense Modifiers</div>
        <div class="sla-dialog-panel-body">
            <div class="sla-dialog-row">
                <label>Target Combat Def Rating</label>
                <div class="sla-dialog-row-inline">
                    <span class="sla-dialog-hint">Applies -1 modifier per point.</span>
                    <input type="number" name="combatDef" value="0" min="0" placeholder="0"
                        class="sla-dialog-input-sm" />
                </div>
            </div>
            <div class="sla-dialog-row">
                <label>Target Acrobatics Rank</label>
                <div class="sla-dialog-row-inline">
                    <span class="sla-dialog-hint">Applies -2 modifier per rank.</span>
                    <input type="number" name="acroDef" value="0" min="0" placeholder="0"
                        class="sla-dialog-input-sm" />
                </div>
            </div>
        </div>
    </div>

    {{!-- RANGED SECTION (Unchanged) --}}
    {{else}}
    <h3 class="sla-dialog-heading">Ranged Options</h3>
    <div class="sla-dialog-hint sla-dialog-hint--block">
        <span class="sla-dialog-accent-text">Base Recoil for this weapon:</span> -{{recoil}} SD
    </div>

    <div class="sla-panel sla-dialog-panel-body">
        <div class="sla-dialog-field-stack">
            <div class="sla-dialog-row">
                <label>Fire Mode</label>
                <select name="fireMode" id="fire-mode" class="sla-dialog-select">
                    {{#each validModes as |mode key|}}
                    <option value="{{key}}" data-recoil="{{mode.recoil}}" data-rounds="{{mode.rounds}}" {{#if (eq
                        key ../selectedMode)}}selected{{/if}}>
                        {{mode.label}} ({{mode.rounds}} rnds | -{{mode.recoil}} Recoil)
                    </option>
                    {{/each}}
                </select>
            </div>

            <div class="sla-dialog-row">
                <label>Cover</label>
                <select name="cover" class="sla-dialog-select">
                    <option value="0">None</option>
                    <option value="-1">Light Cover (-1 SD)</option>
                    <option value="-2">Heavy Cover (-2 SD)</option>
                </select>
            </div>

            {{!-- AIMING SECTION --}}
            {{#if canAim}}
            <div class="sla-dialog-aim-box">
                <div class="sla-dialog-aim-title">Aiming (Max: {{aimLimit}} Rounds)</div>
                <div class="sla-dialog-aim-grid">
                    <div class="sla-dialog-aim-field">
                        <label>+1 Success Die</label>
                        <input type="number" name="aim_sd" value="0" min="0" max="{{aimLimit}}"
                            class="sla-dialog-input-sm" />
                    </div>
                    <div class="sla-dialog-aim-field">
                        <label>Auto Skill Hit</label>
                        <input type="number" name="aim_auto" value="0" min="0" max="{{aimLimit}}"
                            class="sla-dialog-input-sm" />
                    </div>
                </div>
            </div>
            {{/if}}

            <div class="sla-dialog-row">
                <label>Dual Wielding</label>
                <select name="dual" class="sla-dialog-select">
                    <option value="0">No</option>
                    <option value="-2">Same Target (-2 SD)</option>
                    <option value="-4">Diff Target (-4 SD)</option>
                </select>
            </div>
        </div>

        <hr class="sla-dialog-divider sla-dialog-divider--dashed" />

        <div class="sla-dialog-checks">
            <label class="sla-dialog-check"><input type="checkbox" name="targetMoved" /> Target Moving Fast</label>
            <label class="sla-dialog-check"><input type="checkbox" name="blind" /> Blind Firing</label>
            <label class="sla-dialog-check"><input type="checkbox" name="prone" /> Firer Prone</label>
        </div>
    </div>
    {{/if}}
</form>

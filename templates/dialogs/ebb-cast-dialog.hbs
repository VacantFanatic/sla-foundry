<form style="color:#eee;">
    <div style="font-size:0.85em; color:#aaa; margin-bottom:10px;">
        <span style="color:var(--sla-accent)">Formula Rating:</span> {{formulaRating}}
        &nbsp;|&nbsp;
        <span style="color:var(--sla-accent)">FLUX Cost:</span> {{fluxCost}}
    </div>

    <div class="form-group"
        style="margin-bottom:5px; display: flex; justify-content: space-between; align-items: center;">
        <label style="font-weight: bold;">Situational Modifier (+/-)</label>
        <input type="number" name="situationalModifier" value="0" step="1" placeholder="0"
            style="background:#333; color:#fff; border:1px solid #555; text-align:center; width:50px; height: 28px;" />
    </div>

    <div style="font-size:0.8em; color:#aaa; font-style:italic;">
        Apply any one-off modifier to this roll — e.g. +3 for a MOS-3 Ebb reuse (rulebook: -3
        Formula Rating, equivalent to +3 here), or -2 for choking.
    </div>
</form>
